<h1>Welcome to Pexels. Your memory is endless!</h1>
<div class="form-box">
    <%= form_with url: root_path, method: get do |form| %>
    <div class="search-box">
        <%= form.label :collection_id, "Pexels collection ID" %>
        <%= form.text_field :collection_id, placeholder: "e.g 1234ph" %>
    </div>
    <div><%= form.submit "Show Photos" %></div>
    <% end %>
</div>
